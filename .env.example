# 复制成 .env 后按需修改；.env 已在 .gitignore 里，不会入库
# 全部有安全默认值，本地演示可以不改直接 up

# ---- 端口（默认高位，避开 8080 常见占用）----
WEB_PORT=18080
SERVER_PORT=18082
WEB_BIND=0.0.0.0
SERVER_BIND=0.0.0.0

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=minimall
MYSQL_USER=minimall
MYSQL_PASSWORD=minimall123

# ---- Redis ----
REDIS_PASSWORD=

# ---- 后端 ----
# JWT 签名密钥：生产必须换成自己的 32 位以上随机串
SA_JWT_SECRET=changeme-minimall-secret-for-p0
# 图片/文件的对外访问前缀（前后端分离或走 CDN 时改这里）
FILE_DOMAIN=http://localhost:18082/file
